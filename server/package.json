    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mariadb": "^3.5.4",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
