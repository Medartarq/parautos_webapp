{
  "name": "parautos-app-final",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "build": "npm run build:app && node scripts/run-deploy-migrations.mjs",
    "build:app": "npm run build --workspace @parautos/shared && npm run build --workspace @parautos/server && npm run build --workspace @parautos/client",
    "predev": "npm run build --workspace @parautos/shared",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --workspace @parautos/server\" \"npm run dev --workspace @parautos/client\"",
    "migrate": "npm run migrate --workspace @parautos/server",
    "seed:demo": "npm run seed:demo --workspace @parautos/server",
    "seed:demo:1000": "npm run seed:demo:1000 --workspace @parautos/server",
    "verify:demo:1000": "npm run verify:demo:1000 --workspace @parautos/server",
    "purge:demo:1000": "npm run purge:demo:1000 --workspace @parautos/server",
    "seed:reports": "npm run seed:reports --workspace @parautos/server",
    "test": "npm run build --workspace @parautos/shared && npm run test --workspace @parautos/server && npm run test --workspace @parautos/client"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1",
    "esbuild": "0.28.2",
    "body-parser": "2.4.0"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.15"
  }
}
