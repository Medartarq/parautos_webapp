NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=parautos
DB_USER=parautos_app
DB_PASSWORD=replace-me
DB_CONNECTION_LIMIT=5
SESSION_TTL_HOURS=8
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=data/uploads
BOOTSTRAP_ADMIN_EMAIL=admin@parautos.pe
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-random-one-time-token
# Solo para la prueba de integración de migraciones; usar una cuenta de prueba
# con permiso CREATE/DROP DATABASE, nunca credenciales de producción.
