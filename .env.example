NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=parautos
DB_USER=parautos_app
DB_PASSWORD=replace-me
DB_CONNECTION_LIMIT=5
SESSION_TTL_HOURS=8
STORAGE_PROVIDER=local
# `project` usa data/uploads dentro del proyecto (desarrollo).
# Hostinger privado persistente: LOCAL_UPLOAD_BASE=home y
# LOCAL_UPLOAD_DIR=parautos-data/uploads, que se resuelve desde $HOME.
LOCAL_UPLOAD_BASE=project
LOCAL_UPLOAD_DIR=data/uploads
# Producción S3/R2 (requeridas sólo con STORAGE_PROVIDER=s3).
# R2: S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com, S3_REGION=auto
# S3_ENDPOINT puede omitirse para AWS S3.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=parautos
# S3_FORCE_PATH_STYLE=false
BOOTSTRAP_ADMIN_EMAIL=admin@parautos.pe
# Obligatorio sólo hasta crear el primer Administrador; elimínelo después.
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-random-one-time-token
# Solo para la prueba de integración de migraciones; usar una cuenta de prueba
# con permiso CREATE/DROP DATABASE, nunca credenciales de producción.
# MIGRATION_TEST_DB_HOST=127.0.0.1
# MIGRATION_TEST_DB_PORT=3307
# MIGRATION_TEST_DB_USER=parautos_test_admin
# MIGRATION_TEST_DB_PASSWORD=replace-me
