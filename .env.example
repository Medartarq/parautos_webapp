NODE_ENV=development
LOG_LEVEL=info
PORT=3000
APP_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=parautos
DB_USER=parautos_app
DB_PASSWORD=replace-me
DB_CONNECTION_LIMIT=5
DEMO_MODE_ENABLED=false
# Requeridas sólo con DEMO_MODE_ENABLED=true; use otra base y otra carpeta.
# DEMO_DB_HOST=127.0.0.1
# DEMO_DB_PORT=3306
# DEMO_DB_NAME=parautos_demo
# DEMO_DB_USER=parautos_demo_app
# DEMO_DB_PASSWORD=replace-me
# DEMO_LOCAL_UPLOAD_BASE=project
# DEMO_LOCAL_UPLOAD_DIR=data/demo-uploads
# Refresca el lote ficticio en cada despliegue: purga DM#### y recarga.
# Quítela cuando ya no necesite regenerar nombres y fechas.
# DEMO_PURGE_CONFIRM=PURGE
SESSION_TTL_HOURS=8
STORAGE_PROVIDER=local
# `project` usa data/uploads dentro del proyecto (desarrollo).
# Hostinger privado persistente: LOCAL_UPLOAD_BASE=home y
# LOCAL_UPLOAD_DIR=parautos-data/uploads, que se resuelve desde $HOME.
LOCAL_UPLOAD_BASE=project
LOCAL_UPLOAD_DIR=data/uploads
# Producción S3/R2 (requeridas sólo con STORAGE_PROVIDER=s3).
# R2: S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com, S3_REGION=auto
# S3_ENDPOINT puede omitirse para AWS S3.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=parautos
# S3_FORCE_PATH_STYLE=false
# Consulta externa Factiliza (el token debe mantenerse sólo en .env/Hostinger).
FACTILIZA_API_BASE_URL=https://api.factiliza.com/v1
# FACTILIZA_API_TOKEN=
# Tiempo máximo por consulta externa, entre 1000 y 60000 milisegundos.
FACTILIZA_API_TIMEOUT_MS=15000
BOOTSTRAP_ADMIN_EMAIL=admin@parautos.pe
# Obligatorio sólo hasta crear el primer Superadministrador; elimínelo después.
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-random-one-time-token
# Solo para pruebas de integración MariaDB; usar una cuenta de prueba
# con permiso CREATE/DROP DATABASE, nunca credenciales de producción.
# MIGRATION_TEST_DB_HOST=127.0.0.1
# MIGRATION_TEST_DB_PORT=3307
# MIGRATION_TEST_DB_USER=parautos_test_admin
# MIGRATION_TEST_DB_PASSWORD=replace-me
